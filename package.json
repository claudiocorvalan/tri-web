{
  "name": "tri-ingenieria-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next --ignore-pattern coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:static": "node --test tests/static-export.test.mjs",
    "test": "pnpm test:unit && pnpm build && pnpm test:static",
    "check": "pnpm lint && pnpm test:coverage && pnpm build && pnpm test:static"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
